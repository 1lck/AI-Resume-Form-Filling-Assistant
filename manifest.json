{
  "manifest_version": 3,
  "name": "AI简历填表助手",
  "version": "1.1.1",
  "description": "粘贴简历文本，AI解析并自动填写网页表单（不自动提交）",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
